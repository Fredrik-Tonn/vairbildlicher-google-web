# Server configuration
NODE_ENV=development
PORT=3000
# Photos are downscaled in the browser before upload (max. 2048 px, JPEG)
BODY_SIZE_LIMIT=15M
ORIGIN=http://localhost:5173

# Google AI Configuration
# Required: Google Gemini API Key (from Google AI Studio or GCP)
# Used for text, images and speech (Gemini TTS)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Text-to-Speech API Key
# Only set this to use Cloud TTS (de-DE-Neural2-B) instead of Gemini TTS
# GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Optional: Folder with the system prompts (default: local-files/system-prompts, relative to the working directory)
# PROMPTS_DIR=/absolute/path/to/system-prompts

# Optional: Redis Configuration
# If omitted or unavailable, an in-memory cache is automatically used
# REDIS_URL=redis://localhost:6379
