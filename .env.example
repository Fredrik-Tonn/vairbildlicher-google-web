# Server configuration
NODE_ENV=development
PORT=3000
BODY_SIZE_LIMIT=50M
ORIGIN=http://localhost:5173

# Google AI Configuration
# Required: Google Gemini API Key (from Google AI Studio or GCP)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Cloud Text-to-Speech API Key or GCP Credentials
# If omitted, Gemini TTS / fallback is used
GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Optional: Redis Configuration
# If omitted or unavailable, an in-memory cache is automatically used
# REDIS_URL=redis://localhost:6379
